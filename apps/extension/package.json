{
  "name": "@stars-labs/browser-extension",
  "description": "MPC Wallet Browser Extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test tests/services tests/config",
    "test:integration": "bun test tests/integration",
    "test:webrtc": "bun test tests/entrypoints/offscreen/webrtc.*.test.ts",
    "test:interop": "playwright test -c tests/interop/playwright.config.ts",
    "test:interop:smoke": "playwright test -c tests/interop/playwright.config.ts boundary",
    "clean": "rm -rf dist .wxt",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/uuid": "^11.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@ledgerhq/hw-app-eth": "7.8.19",
    "@ledgerhq/hw-app-solana": "7.11.0",
    "@ledgerhq/hw-transport": "6.36.0",
    "@ledgerhq/hw-transport-webhid": "6.36.0",
    "@solana/web3.js": "1.99.0",
    "@stars-labs/core-wasm": "workspace:*",
    "@stars-labs/types": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "buffer": "6.0.3",
    "bs58": "6.0.0",
    "qrcode": "1.5.4",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "viem": "^2.56.9",
    "vite-plugin-wasm": "^3.6.0"
  }
}
